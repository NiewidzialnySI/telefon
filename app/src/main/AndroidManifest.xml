<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- REORDER_TASKS: wymagane przez ActivityManager.moveTaskToFront() —
         bez tego powrót do aplikacji po nadaniu "Wyświetlania nad aplikacjami"
         kończy się SecurityException (widać w logcat). -->
    <uses-permission android:name="android.permission.REORDER_TASKS" />

    <!-- READ_CONTACTS: MainDialerScreen czyta kontakty (wyszukajKontakty),
         bez tego provider kontaktów rzuca SecurityException. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- WRITE_CONTACTS: zapis nowego kontaktu w ContactsContract
         (zapiszNowyKontakt) — bez tego applyBatch rzuca SecurityException
         i kod wpada w fallback (otwarcie systemowego wyboru aplikacji). -->
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />

    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_PHONE_NUMBERS" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_MMS" />
    <uses-permission android:name="android.permission.RECEIVE_WAP_PUSH" />
    <uses-permission android:name="android.permission.WRITE_SMS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.SEND_RESPOND_VIA_MESSAGE" tools:ignore="ProtectedPermissions" />
    <!-- MMS download (mmslib DownloadManager) trzyma wakelock podczas zapisu PDU. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Planowane wysyłanie SMS (scheduled send): dokładny alarm w tle. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
<!-- ===== Pełny dialer: InCallService + nagrywanie rozmów ===== -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />
    <uses-permission android:name="android.permission.MODIFY_PHONE_STATE" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- BLUETOOTH_CONNECT: odczyt nazw sparowanych urządzeń audio (dev.name)
         w oknie wyboru urządzenia Bluetooth. Bez tego odczyt nazwy urządzenia
         (getRemoteName) rzuca SecurityException i crashuje ekran rozmowy. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Widoczność zewnętrznych aplikacji (Messenger, Signal) na Androidzie 11+ -->
    <queries>
        <package android:name="com.facebook.orca" />
        <package android:name="org.thoughtcrime.securesms" />
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Telefon">
        <!-- FileProvider — bezpieczne udostępnianie URI załączników (zdjęć) do MMS/SmsManager. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Telefon"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- WYMAGANE przez ROLE_DIALER: tarcza bez numeru -->
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Tarcza z numerem (tel:...) -->
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tel" />
            </intent-filter>
            <!-- WYMAGANE przez ROLE_SMS: wysyłanie wiadomości z innych aplikacji -->
            <intent-filter>
                <action android:name="android.intent.action.SENDTO" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tel" />
            </intent-filter>
        </activity>

        <!-- CZAT W DYNKU (bubble): osobna aktywność renderująca tylko okno czatu,
             osadzana przez system w nakładce dymka po kliknięciu w bubble SMS.
             allowEmbedded + resizeableActivity są wymagane do osadzenia w dymku. -->
        <activity
            android:name=".BubbleChatActivity"
            android:exported="false"
            android:allowEmbedded="true"
            android:resizeableActivity="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/Theme.Telefon"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- Trampolina do heads-up pełnoekranowego: wybudza ekran przy SMS od
             zapisanego kontaktu, zaraz wraca, a baner heads-up przejmuje ekran. -->
        <activity
            android:name=".FullScreenSmsActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/Theme.Telefon"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- Aktywność ekranu rozmowy: widoczna nad blokadą, nie gaśnie -->
        <activity
            android:name=".call.EkranRozmowyActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/Theme.Telefon.Overlay"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <receiver
            android:name=".call.AkcjaPolaczeniaReceiver"
            android:exported="false" />

        <!-- ===== Uwaga: Własny dymek rozmowy (nakładka SYSTEM_ALERT_WINDOW) =====
             Pokazuje małe zielone kółko, gdy użytkownik zminimalizuje rozmowę.
             Nakładka żyje w osobnym service, więc przetrwa przejście do innej apki. -->
        <service
            android:name=".call.DymekRozmowyService"
            android:exported="false" />

        <!-- ===== Ekran rozmowy: własny interfejs połączeń =====
             Wymaga roli ROLE_DIALER. Bez niej system użyje swojej tarczy. -->
        <service
            android:name=".call.TelefonInCallService"
            android:permission="android.permission.BIND_INCALL_SERVICE"
            android:exported="true"
            android:foregroundServiceType="phoneCall">
            <meta-data
                android:name="android.telecom.IN_CALL_SERVICE_UI"
                android:value="true" />
            <meta-data
                android:name="android.telecom.IN_CALL_SERVICE_RINGING"
                android:value="false" />
            <intent-filter>
                <action android:name="android.telecom.InCallService" />
            </intent-filter>
        </service>

        <!-- ===== Usługa nagrywania rozmów =====
             Typ microphone: nagrywa przez mikrofon (bez CAPTURE_AUDIO_OUTPUT
             nie ma dostępu do strumienia rozmowy). Obie strony słychać
             tylko przy włączonym głośniku. -->
        <service
            android:name=".call.NagrywanieRozmowService"
            android:exported="false"
            android:foregroundServiceType="microphone" />


        <!-- ===== Komponenty wymagane przez system, żeby aplikacja pojawiła się
             na liście domyślnych aplikacji SMS. Brak któregokolwiek = apka
             jest niewidoczna w wyborze, bez żadnego komunikatu. ===== -->

        <!-- 1. Odbiornik SMS: przechwytuje przychodzące wiadomości -->
        <receiver
            android:name=".sms.OdbiorcaSms"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_DELIVER" />
            </intent-filter>
        </receiver>

        <!-- 2. Akcje z powiadomień SMS (kopiuj OTP / szybka odpowiedź) -->
        <receiver
            android:name=".sms.AkcjaSmsReceiver"
            android:exported="false" />

        <!-- 2. WAP PUSH MMS — oficjalny PushReceiver z Fossify mmslib
             (parsuje NotificationInd, zleca downloadMultimediaMessage + grant URI).
             Własny OdbiorcaMms omijał grantUriPermission / MmsFileProvider i gubił PDU. -->
        <receiver
            android:name="com.android.mms.transaction.PushReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_WAP_PUSH">
            <intent-filter>
                <action android:name="android.provider.Telephony.WAP_PUSH_DELIVER" />
                <data android:mimeType="application/vnd.wap.mms-message" />
                <data android:mimeType="application/vnd.wap.sic" />
            </intent-filter>
        </receiver>

        <!-- Status wysyłki / dostarczenia SMS (Fossify pattern) -->
        <receiver
            android:name=".sms.SmsStatusSentReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="dialer.dominik.pl.SMS_SENT" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".sms.SmsStatusDeliveredReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="dialer.dominik.pl.SMS_DELIVERED" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".sms.MmsStatusSentReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="dialer.dominik.pl.MMS_SENT" />
            </intent-filter>
        </receiver>
        <!-- Po downloadzie mmslib szuka receivera po taskAffinity == MMS_RECEIVED. -->
        <receiver
            android:name=".sms.MmsPobranyIZapisanyReceiver"
            android:exported="true"
            android:taskAffinity="com.klinker.android.messaging.MMS_RECEIVED" />

        <!-- 3. Odpowiedź SMS-em na odrzucone połączenie -->
        <service
            android:name=".sms.UslugaOdpowiedziSms"
            android:exported="true"
            android:permission="android.permission.SEND_RESPOND_VIA_MESSAGE">
            <intent-filter>
                <action android:name="android.intent.action.RESPOND_VIA_MESSAGE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
        </service>

        <!-- ===== Identyfikacja rozmów i spamu (ROLE_CALL_SCREENING) ===== -->
        <service
            android:name=".call.UslugaIdentyfikacjiPolaczen"
            android:exported="true"
            android:permission="android.permission.BIND_SCREENING_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>

        <!-- Odbiera alarm zaplanowanej wiadomości SMS (scheduled send) i wysyła ją. -->
        <receiver
            android:name=".sms.WyslijPlanowanySmsReceiver"
            android:exported="false" />

    </application>

</manifest>