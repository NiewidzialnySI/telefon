<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- REORDER_TASKS: wymagane przez ActivityManager.moveTaskToFront() —
         bez tego powrót do aplikacji po nadaniu "Wyświetlania nad aplikacjami"
         kończy się SecurityException (widać w logcat). -->
    <uses-permission android:name="android.permission.REORDER_TASKS" />

    <!-- READ_CONTACTS: MainDialerScreen czyta kontakty (wyszukajKontakty),
         bez tego provider kontaktów rzuca SecurityException. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Autoaktualizacja: instalacja pobranego APK (wymaga zgody „nieznane źródła” dla tej apki). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- WRITE_CONTACTS: zapis nowego kontaktu w ContactsContract
         (zapiszNowyKontakt) — bez tego applyBatch rzuca SecurityException
         i kod wpada w fallback (otwarcie systemowego wyboru aplikacji). -->
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />

    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_PHONE_NUMBERS" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Naprawa Shizuku z powiadomienia: Wi‑Fi + Wireless debugging. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_MMS" />
    <uses-permission android:name="android.permission.RECEIVE_WAP_PUSH" />
    <uses-permission android:name="android.permission.WRITE_SMS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.SEND_RESPOND_VIA_MESSAGE" tools:ignore="ProtectedPermissions" />
    <!-- MMS download (mmslib DownloadManager) trzyma wakelock podczas zapisu PDU. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Planowane wysyłanie SMS (scheduled send): dokładny alarm w tle. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
<!-- ===== Pełny dialer: InCallService ===== -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />
    <uses-permission android:name="android.permission.MODIFY_PHONE_STATE" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- BLUETOOTH_CONNECT: odczyt nazw sparowanych urządzeń audio (dev.name)
         w oknie wyboru urządzenia Bluetooth. Bez tego odczyt nazwy urządzenia
         (getRemoteName) rzuca SecurityException i crashuje ekran rozmowy. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Widoczność zewnętrznych aplikacji (Messenger, Signal, Shizuku) na Androidzie 11+ -->
    <queries>
        <package android:name="com.facebook.orca" />
        <package android:name="org.thoughtcrime.securesms" />
        <package android:name="moe.shizuku.privileged.api" />
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Telefon">
        <!-- FileProvider — bezpieczne udostępnianie URI załączników (zdjęć) do MMS/SmsManager. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Shizuku — binder do UserService nagrywania rozmów (UID shell). -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
        <!-- Własne ADB: shell app_process publikuje INagrywanieShell. -->
        <provider
            android:name=".nagranie.adb.ShellBinderDostawca"
            android:authorities="${applicationId}.shell_binder"
            android:exported="true"
            android:enabled="true" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Telefon"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <!-- LAUNCHER przeniesiony do activity-alias (dynamiczna ikona wg palety). -->
            <!-- WYMAGANE przez ROLE_DIALER: tarcza bez numeru -->
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Tarcza z numerem (tel:...) -->
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tel" />
            </intent-filter>
            <!-- WYMAGANE przez ROLE_SMS: wysyłanie wiadomości z innych aplikacji -->
            <intent-filter>
                <action android:name="android.intent.action.SENDTO" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tel" />
            </intent-filter>
        </activity>

        <!--
          Dynamiczne ikony launchera (activity-alias) — jak icora / XLauncherIcons.
          Tylko jeden alias enabled; IkonaUruchamiacza przełącza przy wyborze palety.
        -->
        <activity-alias
            android:name=".launcher.Ikona_neon_zielony"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_neon_zielony"
            android:roundIcon="@mipmap/ic_launcher_neon_zielony_round"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".launcher.Ikona_rozowa"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_rozowa"
            android:roundIcon="@mipmap/ic_launcher_rozowa_round"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".launcher.Ikona_fioletowa"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_fioletowa"
            android:roundIcon="@mipmap/ic_launcher_fioletowa_round"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".launcher.Ikona_cyjan"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_cyjan"
            android:roundIcon="@mipmap/ic_launcher_cyjan_round"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".launcher.Ikona_niebieska"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_niebieska"
            android:roundIcon="@mipmap/ic_launcher_niebieska_round"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".launcher.Ikona_pomaranczowa"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_pomaranczowa"
            android:roundIcon="@mipmap/ic_launcher_pomaranczowa_round"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".launcher.Ikona_fallout"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_fallout"
            android:roundIcon="@mipmap/ic_launcher_fallout_round"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".launcher.Ikona_wiedzmin"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_wiedzmin"
            android:roundIcon="@mipmap/ic_launcher_wiedzmin_round"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- CZAT W DYNKU (bubble): osobna aktywność renderująca tylko okno czatu,
             osadzana przez system w nakładce dymka po kliknięciu w bubble SMS.
             allowEmbedded + resizeableActivity są wymagane do osadzenia w dymku. -->
        <activity
            android:name=".BubbleChatActivity"
            android:exported="false"
            android:allowEmbedded="true"
            android:resizeableActivity="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/Theme.Telefon"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- Trampolina do heads-up pełnoekranowego: wybudza ekran przy SMS od
             zapisanego kontaktu, zaraz wraca, a baner heads-up przejmuje ekran. -->
        <activity
            android:name=".FullScreenSmsActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/Theme.Telefon"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- Aktywność ekranu rozmowy: widoczna nad blokadą, nie gaśnie -->
        <activity
            android:name=".call.EkranRozmowyActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/Theme.Telefon.Overlay"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- Easter egg 2137 — fejkowe połączenie (offline audio w res/raw). -->
        <activity
            android:name=".call.FejkowePolaczenieJp2Activity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/Theme.Telefon.Overlay"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- Easter egg 420 — Palecze + GIF Santai + beat offline. -->
        <activity
            android:name=".call.FejkowePolaczenie420Activity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/Theme.Telefon.Overlay"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <receiver
            android:name=".call.AkcjaPolaczeniaReceiver"
            android:exported="false" />

        <receiver
            android:name=".call.AkcjaTrwajacejRozmowyReceiver"
            android:exported="false" />

        <!-- Klik powiadomienia: Wi‑Fi + ADB Wi‑Fi + Shizuku. -->
        <receiver
            android:name=".nagranie.ShizukuNaprawaReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="dialer.dominik.pl.NAPRAW_SHIZUKU" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".nagranie.ShizukuBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- ===== Uwaga: Własny dymek rozmowy (nakładka SYSTEM_ALERT_WINDOW) =====
             Pokazuje małe zielone kółko, gdy użytkownik zminimalizuje rozmowę.
             Nakładka żyje w osobnym service, więc przetrwa przejście do innej apki. -->
        <service
            android:name=".call.DymekRozmowyService"
            android:exported="false" />

        <!-- ===== Ekran rozmowy: własny interfejs połączeń =====
             Wymaga roli ROLE_DIALER. Bez niej system użyje swojej tarczy. -->
        <service
            android:name=".call.TelefonInCallService"
            android:permission="android.permission.BIND_INCALL_SERVICE"
            android:exported="true"
            android:foregroundServiceType="phoneCall">
            <meta-data
                android:name="android.telecom.IN_CALL_SERVICE_UI"
                android:value="true" />
            <!-- true = dzwonek wyłącznie przez ZarzadcaDzwonka (bez podwójnego systemowego). -->
            <meta-data
                android:name="android.telecom.IN_CALL_SERVICE_RINGING"
                android:value="true" />
            <intent-filter>
                <action android:name="android.telecom.InCallService" />
            </intent-filter>
        </service>

        <!-- ===== Komponenty wymagane przez system, żeby aplikacja pojawiła się
             na liście domyślnych aplikacji SMS. Brak któregokolwiek = apka
             jest niewidoczna w wyborze, bez żadnego komunikatu. ===== -->

        <!-- 1. Odbiornik SMS: przechwytuje przychodzące wiadomości -->
        <receiver
            android:name=".sms.OdbiorcaSms"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_DELIVER" />
            </intent-filter>
        </receiver>

        <!-- 2. Akcje z powiadomień SMS (kopiuj OTP / szybka odpowiedź) -->
        <receiver
            android:name=".sms.AkcjaSmsReceiver"
            android:exported="false" />

        <!-- 2. WAP PUSH MMS — oficjalny PushReceiver z Fossify mmslib
             (parsuje NotificationInd, zleca downloadMultimediaMessage + grant URI).
             Własny OdbiorcaMms omijał grantUriPermission / MmsFileProvider i gubił PDU. -->
        <receiver
            android:name="com.android.mms.transaction.PushReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_WAP_PUSH">
            <intent-filter>
                <action android:name="android.provider.Telephony.WAP_PUSH_DELIVER" />
                <data android:mimeType="application/vnd.wap.mms-message" />
                <data android:mimeType="application/vnd.wap.sic" />
            </intent-filter>
        </receiver>

        <!-- Status wysyłki / dostarczenia SMS (Fossify pattern) -->
        <receiver
            android:name=".sms.SmsStatusSentReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="dialer.dominik.pl.SMS_SENT" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".sms.SmsStatusDeliveredReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="dialer.dominik.pl.SMS_DELIVERED" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".sms.MmsStatusSentReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="dialer.dominik.pl.MMS_SENT" />
            </intent-filter>
        </receiver>
        <!-- Po downloadzie mmslib szuka receivera po taskAffinity == MMS_RECEIVED. -->
        <receiver
            android:name=".sms.MmsPobranyIZapisanyReceiver"
            android:exported="true"
            android:taskAffinity="com.klinker.android.messaging.MMS_RECEIVED" />

        <!-- 3. Odpowiedź SMS-em na odrzucone połączenie -->
        <service
            android:name=".sms.UslugaOdpowiedziSms"
            android:exported="true"
            android:permission="android.permission.SEND_RESPOND_VIA_MESSAGE">
            <intent-filter>
                <action android:name="android.intent.action.RESPOND_VIA_MESSAGE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
        </service>

        <!-- ===== Identyfikacja rozmów i spamu (ROLE_CALL_SCREENING) ===== -->
        <service
            android:name=".call.UslugaIdentyfikacjiPolaczen"
            android:exported="true"
            android:permission="android.permission.BIND_SCREENING_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>

        <!-- Odbiera alarm zaplanowanej wiadomości SMS (scheduled send) i wysyła ją. -->
        <receiver
            android:name=".sms.WyslijPlanowanySmsReceiver"
            android:exported="false" />

        <!-- Backup Dysku Google — działa w tle po wyjściu z aplikacji. -->
        <service
            android:name=".backup.BackupForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Parowanie Wireless debugging (mDNS + kod w powiadomieniu), jak Shizuku. -->
        <service
            android:name=".nagranie.adb.AdbParowanieService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Odczyt 6‑cyfrowego kodu z okna Wireless debugging (opcjonalnie). -->
        <service
            android:name=".nagranie.adb.AdbParowanieDostepnosc"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:label="@string/adb_parowanie_dostepnosc_label">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/adb_parowanie_dostepnosc" />
        </service>

        <!-- Transkrypcja Whisper w tle + powiadomienie po zakończeniu. -->
        <service
            android:name=".nagranie.TranskrypcjaForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Status PackageInstaller po autoaktualizacji APK. -->
        <receiver
            android:name=".update.AktualizacjaInstallReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="dialer.dominik.pl.update.INSTALL_STATUS" />
            </intent-filter>
        </receiver>

    </application>

</manifest>